# Copie para local.env (fora do Git). Aqui ficam só CAMINHOS para os arquivos de login das CLIs,
# nunca o conteúdo deles. O laboratório copia cada arquivo para dentro da sala descartável (modo 600)
# e o original nunca é montado na sala.
#
# scripts/instalar.sh preenche estes caminhos sozinho quando encontra os logins.
# Linux/macOS: em geral ~/.claude/.credentials.json e ~/.codex/auth.json
# Windows + WSL com as CLIs logadas no Windows: /mnt/c/Users/<usuario>/.claude/.credentials.json

# Codex CLI (rode `codex login` uma vez antes)
LAB_CODEX_AUTH_FILE=

# Claude Code (rode `claude` e faça login uma vez antes)
LAB_CLAUDE_CREDENTIALS_FILE=
# Opcional: estado da CLI (evita perguntas de primeira execução)
LAB_CLAUDE_STATE_FILE=

# Contas extras do mesmo agente (opcional): o mesmo nome com _2 a _9.
# LAB_CLAUDE_CREDENTIALS_FILE_2=/caminho/para/outra-conta/.credentials.json
# LAB_CODEX_AUTH_FILE_2=/caminho/para/outra-conta/auth.json
