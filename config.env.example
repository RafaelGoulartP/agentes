# Limites e imagens das salas. Este arquivo é o padrão versionado e não precisa ser copiado: para
# mudar algum valor nesta máquina, crie config.env (fora do Git) só com as linhas que quer trocar.
#
# Orçamento de cada sala: 4 GiB de RAM e 2 CPUs no total (agente + Docker interno + proxy).
# Com scheduler.maxConcurrency = 3, reserve ~12 GiB para o Docker (no Windows, em .wslconfig).
LAB_MEMORY_AGENT=3g
LAB_MEMORY_DIND=768m
LAB_MEMORY_PROXY=256m
LAB_CPUS_AGENT=1.5
LAB_CPUS_DIND=0.4
LAB_CPUS_PROXY=0.1
LAB_PIDS_AGENT=768
LAB_PIDS_DIND=512
LAB_PIDS_PROXY=128
# Perfil da sala de verificação (LAB_ROOM_PROFILE=verify): sem agente, então o Docker interno, onde
# rodam os bancos dos testes, recebe mais CPU/RAM. O total continua 4 GiB / 2 CPUs.
LAB_VERIFY_MEMORY_AGENT=2560m
LAB_VERIFY_MEMORY_DIND=1280m
LAB_VERIFY_CPUS_AGENT=1.1
LAB_VERIFY_CPUS_DIND=0.8
LAB_PROXY_IMAGE=laboratorio-proxy:local
LAB_DIND_IMAGE=docker:29-dind
